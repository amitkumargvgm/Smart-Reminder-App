    <string name="faq_title">அடிக்கடி கேட்கப்படும் கேள்விகள் (FAQ)</string>
    <string name="faq_q1">நினைவூட்டலை உருவாக்குவது எப்படி?</string>
    <string name="faq_a1">நீங்கள் நேரடியாக தட்டச்சு செய்யலாம், 🎤 மைக் அழுத்திப் பேசலாம் அல்லது புதிய நினைவூட்டல் பொத்தானை அழுத்தலாம்.</string>
    <string name="faq_q2">மீண்டும் மீண்டும் வரும் நினைவூட்டலை அமைப்பது எப்படி?</string>
    <string name="faq_a2">மீண்டும் செய் தேர்வில் தினசரி, வாரந்தோறும் அல்லது மாதந்தோறும் தேர்ந்தெடுக்கவும்.</string>
    <string name="faq_q3">குரல் நினைவூட்டலை எவ்வாறு பயன்படுத்துவது?</string>
    <string name="faq_a3">மைக் பொத்தானை அழுத்தித் தெளிவாகப் பேசுங்கள்.</string>
    <string name="faq_q4">மொழியை எவ்வாறு மாற்றுவது?</string>
    <string name="faq_a4">அமைப்புகளில் சென்று தமிழ் அல்லது பிற மொழிகளைத் தேர்வு செய்யவும்.</string>
    <string name="faq_q5">இது ஆஃப்லைனில் வேலை செய்யுமா?</string>
    <string name="faq_a5">ஆம், இணையம் தேவையின்றி 100% ஆஃப்லைனில் வேலை செய்யும்.</string>
